{
	"name": "worker-libreflare-template",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"libreflare:config": "libreflare-worker config generate",
		"deploy": "npm run libreflare:config && wrangler deploy",
		"dev": "npm run libreflare:config && wrangler dev",
		"start": "npm run dev",
		"typecheck": "npm run libreflare:config && tsc -b",
		"lint": "eslint src/**/*.ts",
		"cf-typegen": "npm run libreflare:config && wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@libreflare/worker-cli": "^0.2.4",
		"@types/node": "^24.12.3",
		"eslint": "^10.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.1",
		"wrangler": "^4.54.0"
	},
	"dependencies": {
		"@libreflare/worker-runtime": "^0.4.5"
	}
}
