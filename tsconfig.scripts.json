{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"types": ["node"]
	},
	"include": ["scripts/**/*.mts"]
}
