/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "worker-libreflare-template",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-01",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": false
	},
	"routes": [
		{
			"pattern": "*example.com/logging-route/*",
			"zone_name": "example.com"
		}
	],
	"vars": {
		"LOG_API_URL": "https://logs.example.com/insert/jsonline?_stream_fields=stream",
		"LOG_SOURCE_KEY": "example-general",
		"LOG_VARY_BY_MONTH": false
	},
	"secrets": {
		"required":[
			"LOG_API_AUTH_HEADERS_JSON"
		]
	},
	"upload_source_maps": true,
	"rules": [
		{
			"type": "Text",
			"globs": [ "**/*.yaml" ],
			"fallthrough": true
		}
	]
}
